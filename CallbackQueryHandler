from telegram import Update
from telegram.ext import ContextTypes

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer() # Butondaki yükleniyor animasyonunu kapatır
    
    data = query.data # Örn: "onayla_6759793667" veya "reddet_6759793667"
    action, user_id = data.split("_")
    user_id = int(user_id)
    
    if action == "onayla":
        # 1. Başvuru yapan kullanıcıya haber ver
        try:
            await context.bot.send_message(
                chat_id=user_id,
                text="🎉 Tebrikler! Kulüp başvurunuz onaylandı."
            )
        except Exception as e:
            print(f"Kullanıcıya mesaj atılamadı: {e}")
            
        # 2. Admin panelindeki (sana gelen) mesajı güncelle, butonları kaldır
        await query.edit_message_text(
            text=query.message.text + "\n\n✅ **Durum:** Onaylandı",
            parse_mode="Markdown"
        )
        
    elif action == "reddet":
        # 1. Başvuru yapan kullanıcıya haber ver
        try:
            await context.bot.send_message(
                chat_id=user_id,
                text="❌ Maalesef kulüp başvurunuz reddedildi."
            )
        except Exception as e:
            print(f"Kullanıcıya mesaj atılamadı: {e}")
            
        # 2. Admin panelindeki mesajı güncelle
        await query.edit_message_text(
            text=query.message.text + "\n\n❌ **Durum:** Reddedildi",
            parse_mode="Markdown"
        )
